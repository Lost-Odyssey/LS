// enum_drop_bench.lls — isolate the cost of the post-drop slot
// invalidation store (whole-slot zeroing vs 1-byte dead-tag sentinel).
// All Str payloads are static literals (cap=0, drop is a no-op), so per
// iteration the drop path costs: synthesized __drop call (all branches
// no-op) + the invalidation store. Compare wall clock with
// LS_NO_DROP_SENTINEL=1 (legacy zeroing) vs default (sentinel).
//
// IMPORTANT: the match subject must be an OWNED RVALUE (a fresh call
// result consumed directly by match), not a named local. Matching a
// named local (`Fat f = ..; match f {..}`) is a borrow-match: scope
// cleanup runs through emit_enum_drop_cond, which calls the drop-fn
// directly and never emits the invalidation store this benchmark is
// measuring (that store lives only in emit_enum_drop, the owned-rvalue
// path). An earlier revision of this file matched a named local and
// silently measured nothing — verify with `emit-ir | grep dead.tag.p`
// before trusting new numbers if this file is touched again.

enum Fat {
    Nil
    Big(Str, Str, Str, Str)
}

def mk_fat(int i) -> Fat {
    return Big("aaaaaaaa", "bbbbbbbb", "cccccccc", "dddddddd")
}

def churn(int i) -> int {
    match mk_fat(i) {
        Big(a, b, c, d) => { return a.len() + i }
        Nil => { return 0 }
    }
}

def main() {
    int acc = 0
    for i in 0..2000000 {
        acc = acc + churn(i)
    }
    @print(f"acc={acc}")
}
