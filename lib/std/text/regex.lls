// std/regex.ls — LS regular expression stdlib (Pike VM NFA, pure C backend)
//
// Import:  import std.text.regex as re
// All functions return false/empty/0 on invalid pattern (no crash).
//
// Flags passed to compile -- use the named constants below (IGNORECASE /
// MULTILINE / DOTALL), or write them inline in the pattern ((?i)/(?m)/(?s))
// and leave the flags argument off entirely. The LS_RE_* spellings that used
// to be listed here are C macros in runtime/ls_regex.h and were never LS
// symbols: `re.compile(p, LS_RE_IGNORECASE)` was an undefined variable.
//
//   capture()     -> Vec(Str)        — empty = no match
//   capture_all() -> Vec(Str)        — flat: all groups from all matches
//   capture_all_spans()  -> Vec(int)      — flat, zero-alloc: (offset,len) pairs
//   capture_all_slices() -> Vec(StrSlice) — flat, zero-alloc, directly usable
//   capture_named() -> Map(Str,Str)  — empty = no match
// Use group_count(pattern) to get the per-match stride for capture_all /
// capture_all_spans (spans stride is (group_count+1)*2 ints) /
// capture_all_slices (same stride as capture_all: group_count+1).
//
// FFI (P5-3): the C regex engine is a direct extern taking char*/length. Str
// values are handed across via `str.c_str()` (NUL-terminated) + `str.len()`;
// the exec pointer is hoisted once per loop (c_str is O(1) after the first
// call). Substrings come back as owned Str via Str.substr.

import std.core.vec
import std.core.map
import std.sys.c as c
import std.core.str

// ---- flags ----
//
// Bitmask, OR them together. Each also has an inline pattern form, which needs
// no flags argument at all: (?i) (?m) (?s). Values must stay in step with
// LS_RE_* in runtime/ls_regex.h -- pinned by tests/samples/regex_flags.lls.
int IGNORECASE = 1   // (?i) -- case-insensitive
int MULTILINE  = 2   // (?m) -- ^ and $ match at line boundaries
int DOTALL     = 4   // (?s) -- . also matches 


// ---- internal helpers ----

// Cached compile for the free functions: the handle is owned by the C-side
// thread-local cache and must NOT be freed here. Returns nil when the pattern
// is invalid, or when it is too long to cache -- callers fall back to _own.
def _cached(Str pattern, int flags) -> object {
    return c.__ls_regex_cached(pattern.c_str(), flags)
}

// Uncached compile; the caller owns the handle and must free it.
def _own(Str pattern, int flags) -> object {
    return c.__ls_regex_compile(pattern.c_str(), flags)
}

// ---- Allocation-free match results ----

// Byte range of one capture group: [start, start+len) into the matched text.
// A plain POD value -- no allocation, no destructor, no borrow. This is what
// you want when the position or the length is the answer; reach for StrSlice
// (below) only when you need the bytes.
struct Span {
    int start
    int len
}

methods Span {
    // Not named `end`: that is a reserved keyword (see src/scanner.c's
    // keyword table), so `def end(...)` is a parse error.
    def end_offset(&self) -> int { return self.start + self.len }
    def empty?(&self) -> bool { return self.len == 0 }
}

// A successful match, bound to the text it was made against: LS's shape of
// Rust's Captures<'t>, minus the static lifetime proof.
//
// POD by construction (an opaque handle plus a fat pointer): no destructor,
// no ownership, nothing to free. It BORROWS both the Regex's handle and the
// text, so:
//   * it is only valid while both are alive -- nothing checks this;
//   * running the same Regex again invalidates it, because the offsets it
//     reads are the handle's "last match" state, the same state group()
//     reads. Take the values you need before re-matching.
// Both facts are the price of not copying the offsets out on every call,
// which is exactly the cost this whole layer exists to avoid.
struct Caps {
    object h
    *u8 base
    int base_len
}

methods Caps {
    // False once the Regex has been run against some other text: the offsets
    // every reader below would read describe THAT text, not the one this Caps
    // is bound to. Reading through a stale Caps used to hand back a
    // plausible-looking wrong substring (bind to "abc12", re-match "zz7ab",
    // read group 1 -> "ab"), so every reader gates on this and reports
    // absent instead.
    //
    // Not public: there is no useful "is it still fresh?" question a caller
    // can act on that None/-1 does not already answer.
    def _fresh?(&self) -> bool {
        return c.__ls_regex_text_is(self.h, self.base, self.base_len) != 0
    }

    // Length of group `i`, or -1 when the group is absent (did not
    // participate, no match, or out of range) or this Caps is stale. -1
    // rather than 0 because an empty group that DID participate is a
    // different fact and reports 0.
    def len(&self, int i) -> int {
        if !self._fresh?() { return -1 }
        if i < 0 || i > c.__ls_regex_group_count(self.h) { return -1 }
        return c.__ls_regex_cap_len(self.h, i)
    }

    // Byte span of group `i`, or None if absent or this Caps is stale. No
    // text needed.
    def span(&self, int i) -> Option(Span) {
        if !self._fresh?() { return None }
        if i < 0 || i > c.__ls_regex_group_count(self.h) { return None }
        int s = c.__ls_regex_cap_start(self.h, i)
        int l = c.__ls_regex_cap_len(self.h, i)
        if s < 0 || l < 0 { return None }
        return Some(Span { start: s, len: l })
    }

    // Group `i` as a borrowed view into the text this Caps was made from.
    // No text argument -- that is the point of this layer.
    def slice(&self, int i) -> Option(StrSlice) {
        if !self._fresh?() { return None }
        if i < 0 || i > c.__ls_regex_group_count(self.h) { return None }
        int s = c.__ls_regex_cap_start(self.h, i)
        int l = c.__ls_regex_cap_len(self.h, i)
        if s < 0 || l < 0 { return None }
        if s + l > self.base_len { return None }
        return Some(StrSlice { ptr: c.__ls_ptr_at(self.base, s as i64), len: l })
    }

    // Group `i` as an owned Str. Allocates; the escape hatch for when the
    // value has to outlive the text.
    def str(&self, int i) -> Option(Str) {
        match self.slice(i) {
            Some(sl) => { return Some(sl.to_str()) }
            None     => { return None }
        }
    }

    // Number of capture groups, not counting group 0.
    def group_count(&self) -> int {
        return c.__ls_regex_group_count(self.h)
    }
}

// ---- Compiled pattern object ----
//
// Regex owns a C-side handle and releases it at scope exit. It has a
// destructor and no Clone, which makes it MOVE-ONLY: passing it by value is a
// compile error (use `&Regex`), and ownership transfers on move. Same shape as
// io.File.
//
// Use this when the same pattern runs more than once. The free functions below
// take the pattern as a string and go through a thread-local cache, which is
// convenient for one-off calls but cannot hand you the match state.
struct Regex {
    object h
}

methods Regex: Destroy {
    def ~(&!self) {
        if self.h != nil {
            c.__ls_regex_free(self.h)
            self.h = nil
        }
    }
}

methods Regex {
    // True if the pattern occurs anywhere in `text`. Allocates nothing: the
    // match offsets stay in the handle until you ask for a group.
    //
    // CONTRACT: this is the "last match" call that `group()` reads offsets
    // from. If you later call `group(&other_text, i)` with a `Str` that is
    // NOT the same one you passed here, `group` has no way to detect that —
    // it will slice `other_text` at offsets that were computed against THIS
    // `text` and hand back plausible-looking, silently wrong data (bounds
    // are still checked, so it cannot read out of `other_text`, but the
    // substring itself belongs to the wrong string). Always pass the exact
    // same `text` to `group`/`find_from` that you last matched with.
    //
    // Uses `text.as_ptr()` rather than `text.c_str()`: the latter needs a
    // writable self (it may grow the buffer to append a NUL terminator), but
    // `&self` here is a read-only borrow. `__ls_regex_exec` is given the
    // length explicitly and never reads past it, so it has no need for NUL
    // termination anyway.
    def matches?(&self, &Str text) -> bool {
        return c.__ls_regex_exec(self.h, text.as_ptr() as *u8, text.len(), 0) > 0
    }

    // Same, but starts scanning at byte offset `start`. Also sets the "last
    // match" state that `group()` reads — see the CONTRACT note on
    // `matches?` above: the `text` you pass to a following `group()` call
    // must be this same `text`.
    def find_from(&self, &Str text, int start) -> bool {
        return c.__ls_regex_exec(self.h, text.as_ptr() as *u8, text.len(), start) > 0
    }

    // Same question as matches?() -- true if the pattern occurs anywhere in
    // `text` -- but a NARROWER contract in exchange for speed on patterns
    // eligible for the D1 lazy-DFA fast path (see is_dfa_eligible()): do NOT
    // rely on group(i) for i > 0 after calling this. group(0) (the whole
    // match) is always exact. Reading a sub-group still WORKS (it is
    // recovered transparently, see runtime/ls_regex.c's
    // re_dfa_fill_captures) but costs one extra internal re-match the first
    // time you do it -- if your call site is going to read several
    // sub-groups every time anyway, matches?() is cheaper overall (it never
    // pays for the DFA scan AND a fallback re-match on the same call); use
    // is_match() only when you mostly or always just need the yes/no answer
    // (or group(0)), which is exactly the shape a hot loop that only
    // measures/filters on the whole match has.
    def is_match(&self, &Str text) -> bool {
        return c.__ls_regex_exec_dfa(self.h, text.as_ptr() as *u8, text.len(), 0) > 0
    }

    // Group `i` of the last successful match on THIS Regex, materialized on
    // demand. Group 0 is the whole match. None if there was no match, if the
    // group did not participate, or if `i` is out of range.
    //
    // CONTRACT: `text` MUST be the same `Str` passed to the preceding
    // `matches?`/`find_from` call on this handle — see the note there. As a
    // cheap, sound safety net (not a substitute for passing the right
    // `text`), this also returns `None` when the stored offsets do not fit
    // inside `text` (`s + l > text.len()`), which catches the case where a
    // shorter, unrelated `text` is passed by mistake. It cannot catch an
    // unrelated `text` that happens to be long enough — that case still
    // returns a plausible-looking but wrong substring.
    def group(&self, &Str text, int i) -> Option(Str) {
        if i < 0 || i > c.__ls_regex_group_count(self.h) { return None }
        if c.__ls_regex_text_is(self.h, text.as_ptr() as *u8, text.len()) == 0 { return None }
        int s = c.__ls_regex_cap_start(self.h, i)
        int l = c.__ls_regex_cap_len(self.h, i)
        if s < 0 || l < 0 { return None }
        if s + l > text.len() { return None }
        return Some(text.substr(s, l))
    }

    // Byte span of group `i` of the last successful match, or None if there
    // was no match, the group did not participate, or `i` is out of range.
    //
    // Takes NO text. The offsets live in the handle, so there is nothing a
    // caller could pass wrong here -- the "must be the same `text` you last
    // matched with" contract that group()/group_slice() carry does not apply
    // to this method at all. Prefer it whenever the length or position is
    // what you actually want: it allocates nothing, and on a two-group
    // extract it is ~1.9x the whole shape's cost at -O2 against group().
    //
    // An absent group and a participating-but-empty group are different
    // facts and stay different here: absent is None, empty is
    // Some(Span{start, 0}).
    def group_span(&self, int i) -> Option(Span) {
        if i < 0 || i > c.__ls_regex_group_count(self.h) { return None }
        int s = c.__ls_regex_cap_start(self.h, i)
        int l = c.__ls_regex_cap_len(self.h, i)
        if s < 0 || l < 0 { return None }
        return Some(Span { start: s, len: l })
    }

    // Group `i` of the last successful match as a borrowed view into `text`.
    // Allocates nothing -- StrSlice is a (ptr, len) fat value, and it already
    // carries the operations you would reach for on the bytes themselves
    // (len/at/==/compare/find/to_int/to_str/hash, see std.core.str).
    //
    // CONTRACT: same as group() -- `text` MUST be the `Str` passed to the
    // preceding matches?/find_from on this handle. The `s + l > text.len()`
    // net below catches a shorter unrelated `text`; it cannot catch one that
    // happens to be long enough. Unlike group(), the value you get back is a
    // BORROW: it is only valid while `text` is alive, and nothing checks
    // that. Use group_span() instead when you do not need the bytes.
    def group_slice(&self, &Str text, int i) -> Option(StrSlice) {
        if i < 0 || i > c.__ls_regex_group_count(self.h) { return None }
        if c.__ls_regex_text_is(self.h, text.as_ptr() as *u8, text.len()) == 0 { return None }
        int s = c.__ls_regex_cap_start(self.h, i)
        int l = c.__ls_regex_cap_len(self.h, i)
        if s < 0 || l < 0 { return None }
        if s + l > text.len() { return None }
        return Some(StrSlice { ptr: c.__ls_ptr_at(text.as_ptr() as *u8, s as i64), len: l })
    }

    // Match `text` and, on success, hand back a Caps value bound to it, so
    // the per-group reads below it need no further `text` argument.
    //
    // This is where the borrow belongs. Stashing the text pointer in the
    // Regex itself would remove the same argument, but a Regex normally
    // outlives the text it is run against (compiled once outside a loop,
    // matched against a fresh per-iteration Str) -- it would hold a dangling
    // pointer most of the time, and there would be nothing left at the call
    // site to check it against. Rust does not do that either: its Regex is
    // text-free and it is Captures<'t>, a per-call value, that carries the
    // lifetime. Caps is that shape without the static proof.
    def caps(&self, &Str text) -> Option(Caps) {
        if !self.matches?(text) { return None }
        return Some(Caps { h: self.h, base: text.as_ptr() as *u8, base_len: text.len() })
    }

    // Number of capture groups, not counting group 0.
    def group_count(&self) -> int {
        return c.__ls_regex_group_count(self.h)
    }

    // True if the pattern was classified one-pass at compile time (at most
    // one thread can ever be live at any input position, so a future
    // execution path could walk a single pc and write captures directly
    // instead of running the general thread-list VM). Diagnostic surface:
    // execution today is identical either way, this just exposes the
    // property so it can be tested before anything depends on it.
    def is_onepass(&self) -> bool {
        return c.__ls_regex_is_onepass(self.h) > 0
    }

    // True if the pattern is eligible for the lazy-DFA match-only fast path
    // (one-pass, non-multiline, no mid-pattern ^ / \A -- see
    // re_dfa_check_eligible in runtime/ls_regex.c). Diagnostic surface, same
    // spirit as is_onepass(): is_match() (and the free functions
    // matches()/full_match()/find()/find_all()/replace()/replace_all()/
    // split(), which only ever read group 0 themselves) route through the
    // DFA exactly when this is true. matches?()/find_from() do NOT --
    // their documented contract lets a caller read ANY group() afterward,
    // which the DFA does not compute, so routing them through it would
    // make every such read pay for a full internal re-match on top of the
    // DFA scan; see is_match()'s doc comment for the trade-off this avoids.
    def is_dfa_eligible(&self) -> bool {
        return c.__ls_regex_is_dfa_eligible(self.h) > 0
    }
}

// Compiles `pattern`. Returns Err with the engine's message when the pattern
// is malformed.
def compile(Str pattern, int flags = 0) -> Result(Regex, Str) {
    object h = _own(pattern, flags)
    if h == nil {
        return Err(from_cstr(c.__ls_regex_last_error()))
    }
    return Ok(Regex{ h: h })
}

// Extract capture group `group` (of the last exec on `h`) as an owned Str.
def _cap_str(object h, &Str text, int group) -> Str {
    int s = c.__ls_regex_cap_start(h, group)
    int l = c.__ls_regex_cap_len(h, group)
    if s < 0 { return "" }
    return text.substr(s, l)
}

// ---- 3.1 Basic matching ----

// Returns true if pattern appears anywhere in text.
def matches(Str text, Str pattern) -> bool {
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil { return false }
    // matches() never reads any group -- always safe for the DFA-only fast
    // path (see __ls_regex_exec_dfa's contract in runtime/ls_regex.h).
    int n = c.__ls_regex_exec_dfa(h, text.c_str(), text.len(), 0)
    if owned { c.__ls_regex_free(h) }
    return n > 0
}

// Returns true if the entire text matches pattern (anchored both ends).
def full_match(Str text, Str pattern) -> bool {
    Str anchored = "\\A(?:" + pattern + ")\\Z"
    object h = _cached(anchored, 0)
    bool owned = false
    if h == nil { h = _own(anchored, 0); owned = true }
    if h == nil { return false }
    int n = c.__ls_regex_exec_dfa(h, text.c_str(), text.len(), 0)
    if owned { c.__ls_regex_free(h) }
    return n > 0
}

// ---- 3.2 Find ----

// Returns Some(first_match) or None.
def find(Str text, Str pattern) -> Option(Str) {
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil { return None }
    // Only group 0 is ever read below (_cap_str(h, text, 0)) -- safe.
    int n = c.__ls_regex_exec_dfa(h, text.c_str(), text.len(), 0)
    if n == 0 { if owned { c.__ls_regex_free(h) }; return None }
    Str ms = _cap_str(h, text, 0)
    if owned { c.__ls_regex_free(h) }
    return Some(ms)
}

// Returns all non-overlapping full matches.
def find_all(Str text, Str pattern) -> Vec(Str) {
    Vec(Str) result = {}
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil { return result }
    *u8 tptr = text.c_str()
    int tlen = text.len()
    int pos = 0
    while pos <= tlen {
        // Only group 0 is ever read in this loop -- safe for the DFA-only
        // fast path.
        int n = c.__ls_regex_exec_dfa(h, tptr, tlen, pos)
        if n == 0 { break }
        int s = c.__ls_regex_cap_start(h, 0)
        int l = c.__ls_regex_cap_len(h, 0)
        Str piece = text.substr(s, l)
        result.push(piece)
        if l == 0 { pos = s + 1 } else { pos = s + l }
    }
    if owned { c.__ls_regex_free(h) }
    return result
}

// ---- 3.3 Numbered capture groups ----

// Returns [full_match, group1, group2, ...] for the first match, or empty Vec.
def capture(Str text, Str pattern) -> Vec(Str) {
    Vec(Str) caps = {}
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil { return caps }
    int n = c.__ls_regex_exec(h, text.c_str(), text.len(), 0)
    if n == 0 { if owned { c.__ls_regex_free(h) }; return caps }
    int i = 0
    while i < n {
        Str g = _cap_str(h, text, i)
        caps.push(g)
        i = i + 1
    }
    if owned { c.__ls_regex_free(h) }
    return caps
}

// Returns the number of capture groups in the pattern (not counting group 0).
def group_count(Str pattern) -> int {
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil { return 0 }
    int n = c.__ls_regex_group_count(h)
    if owned { c.__ls_regex_free(h) }
    return n
}

// Returns all matches with all groups, packed flat into a single Vec.
// Layout: [g0_m0, g1_m0, ..., gN_m0, g0_m1, g1_m1, ..., gN_m1, ...]
// Stride = group_count(pattern) + 1.  Returns empty Vec if no matches.
def capture_all(Str text, Str pattern) -> Vec(Str) {
    Vec(Str) result = {}
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil { return result }
    *u8 tptr = text.c_str()
    int tlen = text.len()
    int pos = 0
    while pos <= tlen {
        int n = c.__ls_regex_exec(h, tptr, tlen, pos)
        if n == 0 { break }
        int s = c.__ls_regex_cap_start(h, 0)
        int l = c.__ls_regex_cap_len(h, 0)
        int i = 0
        while i < n {
            Str g = _cap_str(h, text, i)
            result.push(g)
            i = i + 1
        }
        if l == 0 { pos = s + 1 } else { pos = s + l }
    }
    if owned { c.__ls_regex_free(h) }
    return result
}

// ---- 3.3.1 Capture group spans (zero-allocation find-all) ----

// Same match/group traversal as capture_all, but instead of materializing
// each group into an owned Str, packs (offset, length) pairs into a flat
// Vec(int). No Str is allocated by this call -- not even for group 0: the
// only allocation left is the Vec(int)'s own backing-array growth, the same
// bookkeeping cost capture_all's Vec(Str) already pays on top of its
// per-group Str allocations.
//
// Layout: [g0_off, g0_len, g1_off, g1_len, ..., gN_off, gN_len] for match 0,
// then the same 2*(group_count+1) ints for match 1, and so on. Stride (in
// ints) = (group_count(pattern) + 1) * 2. Empty Vec if there are no matches.
//
// A group that did not participate in a match is encoded as (-1, -1) --
// exactly the "absent" sentinel __ls_regex_cap_start/cap_len already
// return, so there is no translation step at this layer: check `off < 0`
// before slicing (the same check `group()` above makes before calling
// substr). An empty (zero-width) match or group is (offset, 0) -- a real,
// present, zero-length span -- which is a different case from "absent".
//
// To turn a span back into text once you actually need the bytes: `text.
// substr(off, len)` for an owned copy (the same call capture_all makes
// internally, so switching call sites costs nothing) or `text.subslice(off,
// len)` for a zero-copy StrSlice view (valid only while `text` is
// unchanged) -- both already exist on Str, so this is not a new idiom.
//
// Use this instead of capture_all() when a caller only needs to measure,
// compare, or scan groups -- e.g. summing lengths, or checking a group
// equals a literal -- without needing the bytes as an owned, independent
// Str. If you are going to materialize every group anyway, capture_all() is
// simpler; this exists for the case where most or all of that
// materialization would otherwise be wasted work.
def capture_all_spans(Str text, Str pattern) -> Vec(int) {
    Vec(int) result = {}
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil { return result }
    *u8 tptr = text.c_str()
    int tlen = text.len()
    int pos = 0
    while pos <= tlen {
        int n = c.__ls_regex_exec(h, tptr, tlen, pos)
        if n == 0 { break }
        int s = c.__ls_regex_cap_start(h, 0)
        int l = c.__ls_regex_cap_len(h, 0)
        int i = 0
        while i < n {
            result.push(c.__ls_regex_cap_start(h, i))
            result.push(c.__ls_regex_cap_len(h, i))
            i = i + 1
        }
        if l == 0 { pos = s + 1 } else { pos = s + l }
    }
    if owned { c.__ls_regex_free(h) }
    return result
}

// ---- 3.3.2 Capture group slices (zero-allocation, DIRECTLY USABLE find-all) ----

// Same match/group traversal as capture_all_spans, but packs StrSlice
// (ptr+len fat views, lib/std/core/str_core.lls) instead of raw ints. Every
// argument for capture_all_spans over capture_all applies here too (no Str
// materialized, not even for group 0) -- this exists on top of it because a
// caller who wants to actually USE a captured field (compare it, search it,
// parse it with StrSlice.to_int/to_i64/to_float) had to hand-decode
// (offset,len) pairs and call text.subslice(off, len) themselves to get
// there. capture_all_slices does that decoding once, so the result is
// immediately usable: `slices[j].eq_str("GET")`, `slices[j].to_int()`, no
// arithmetic at the call site.
//
// Layout: [g0, g1, ..., gN] for match 0, then the same group_count+1
// elements for match 1, and so on -- SAME stride as capture_all (not
// doubled like capture_all_spans' int pairs, since each element is already
// a complete StrSlice). Empty Vec if there are no matches.
//
// Absent vs empty (both required to be representable -- neither is a
// crash, neither is garbage):
//   * A group that did NOT participate in a match is encoded as the
//     ABSENT sentinel StrSlice { ptr: nil, len: 0 } -- there is no byte
//     range to point at, so this is the one case where a StrSlice does not
//     point into `text`'s buffer. Check `slice.present?()` before using
//     one you got from this function if the pattern has an optional group
//     ((...)?/(...|)) -- calling .at()/.eq_str()/etc. on an absent slice
//     is safe (len == 0 means every bounds-checked read degenerates to the
//     empty case) but is never what you meant. `to_int()`/`to_i64()`/
//     `to_float()` in particular treat it exactly like Str.to_int("") --
//     Err("empty string") -- because len == 0 short-circuits before
//     `ptr` is ever read; there is no null-pointer dereference here.
//   * An empty (zero-width) match or group is StrSlice { ptr: <valid,
//     pointing at the match position>, len: 0 } -- PRESENT (`present?()`
//     is true), just zero bytes. `present?()` is what distinguishes the
//     two; `len()` alone cannot (both are 0).
//
// SAFETY (inherited from StrSlice's own contract, see the struct doc
// comment): every present slice borrows from `text`. It dangles if `text`
// is destroyed, mutated (push_str/+/reserve may realloc), or was a
// temporary -- keep `text` alive and unchanged for as long as you use the
// result. Materialize a slice you need to keep past `text`'s lifetime with
// `.to_str()`.
def capture_all_slices(Str text, Str pattern) -> Vec(StrSlice) {
    Vec(StrSlice) result = {}
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil { return result }
    *u8 tptr = text.c_str()
    int tlen = text.len()
    int pos = 0
    while pos <= tlen {
        int n = c.__ls_regex_exec(h, tptr, tlen, pos)
        if n == 0 { break }
        int s = c.__ls_regex_cap_start(h, 0)
        int l = c.__ls_regex_cap_len(h, 0)
        int i = 0
        while i < n {
            int gs = c.__ls_regex_cap_start(h, i)
            int gl = c.__ls_regex_cap_len(h, i)
            if gs < 0 {
                *u8 z = nil
                result.push(StrSlice { ptr: z, len: 0 })
            } else {
                result.push(StrSlice { ptr: c.__ls_ptr_at(tptr, gs as i64), len: gl })
            }
            i = i + 1
        }
        if l == 0 { pos = s + 1 } else { pos = s + l }
    }
    if owned { c.__ls_regex_free(h) }
    return result
}

// ---- 3.4 Named capture groups ----

// Returns a map {name -> value} for named groups in the first match.
// Returns an empty map if no match or no named groups.
def capture_named(Str text, Str pattern) -> Map(Str, Str) {
    Map(Str, Str) m = {}
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil { return m }
    int n = c.__ls_regex_exec(h, text.c_str(), text.len(), 0)
    if n == 0 { if owned { c.__ls_regex_free(h) }; return m }
    int nc = c.__ls_regex_named_count(h)
    int i = 0
    while i < nc {
        Str name = from_cstr(c.__ls_regex_named_name(h, i))
        int idx = c.__ls_regex_named_index(h, i)
        int s = c.__ls_regex_cap_start(h, idx)
        int l = c.__ls_regex_cap_len(h, idx)
        if s >= 0 {
            Str val = text.substr(s, l)
            m.set(name, val)
        }
        i = i + 1
    }
    if owned { c.__ls_regex_free(h) }
    return m
}

// ---- 3.5 Replace ----

// Replaces the first match of pattern with replacement.
def replace(Str text, Str pattern, Str replacement) -> Str {
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil { return text.copy() }
    // Only group 0 is ever read below -- safe for the DFA-only fast path.
    int n = c.__ls_regex_exec_dfa(h, text.c_str(), text.len(), 0)
    if n == 0 { if owned { c.__ls_regex_free(h) }; return text.copy() }
    int s = c.__ls_regex_cap_start(h, 0)
    int l = c.__ls_regex_cap_len(h, 0)
    int tlen = text.len()
    Str result = text.substr(0, s) + replacement + text.substr(s + l, tlen - s - l)
    if owned { c.__ls_regex_free(h) }
    return result
}

// Replaces all non-overlapping matches of pattern with replacement.
def replace_all(Str text, Str pattern, Str replacement) -> Str {
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil { return text.copy() }
    Str result = ""
    *u8 tptr = text.c_str()
    int tlen = text.len()
    int pos = 0
    while pos <= tlen {
        // Only group 0 is ever read in this loop -- safe.
        int n = c.__ls_regex_exec_dfa(h, tptr, tlen, pos)
        if n == 0 { break }
        int s = c.__ls_regex_cap_start(h, 0)
        int l = c.__ls_regex_cap_len(h, 0)
        result = result + text.substr(pos, s - pos) + replacement
        if l == 0 { result = result + text.substr(s, 1); pos = s + 1 }
        else { pos = s + l }
    }
    result = result + text.substr(pos, tlen - pos)
    if owned { c.__ls_regex_free(h) }
    return result
}

// ---- 3.6 Split ----

// Splits text at each match of pattern; empty strings from consecutive
// separators are omitted.
def split(Str text, Str pattern) -> Vec(Str) {
    Vec(Str) result = {}
    object h = _cached(pattern, 0)
    bool owned = false
    if h == nil { h = _own(pattern, 0); owned = true }
    if h == nil {
        result.push(text.copy())
        return result
    }
    *u8 tptr = text.c_str()
    int tlen = text.len()
    int pos = 0
    while pos <= tlen {
        // Only group 0 is ever read in this loop -- safe.
        int n = c.__ls_regex_exec_dfa(h, tptr, tlen, pos)
        if n == 0 { break }
        int s = c.__ls_regex_cap_start(h, 0)
        int l = c.__ls_regex_cap_len(h, 0)
        Str piece = text.substr(pos, s - pos)
        if piece.len() > 0 { result.push(piece) }
        if l == 0 { pos = s + 1 } else { pos = s + l }
    }
    if pos <= tlen {
        Str tail = text.substr(pos, tlen - pos)
        if tail.len() > 0 { result.push(tail) }
    }
    if owned { c.__ls_regex_free(h) }
    return result
}
