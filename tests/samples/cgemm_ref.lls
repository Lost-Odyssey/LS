// Pins the scalar reference against hand-computed values. The reference
// DEFINES the operation order every vector kernel must copy, so this corpus
// is the anchor for every bit-exactness claim later.
import std.sci.cgemm as cg
import std.sys.c as c
import cgemm_testutil as tu

def main() {
    // A = [[1+2i, 3-1i]]  (1x2),  B = [[2+0i], [0+1i]]  (2x1)
    // A*B = (1+2i)(2+0i) + (3-1i)(0+1i) = (2+4i) + (1+3i) = 3+7i
    *f32 Ar = c.malloc(8) as *f32
    *f32 Ai = c.malloc(8) as *f32
    *f32 Br = c.malloc(8) as *f32
    *f32 Bi = c.malloc(8) as *f32
    *f32 Cr = c.malloc(4) as *f32
    *f32 Ci = c.malloc(4) as *f32

    Ar[0] = 1.0 as f32; Ar[1] = 3.0 as f32
    Ai[0] = 2.0 as f32; Ai[1] = -1.0 as f32
    Br[0] = 2.0 as f32; Br[1] = 0.0 as f32
    Bi[0] = 0.0 as f32; Bi[1] = 1.0 as f32
    Cr[0] = 0.0 as f32; Ci[0] = 0.0 as f32

    cg.cgemm_ref(Ar, Ai, 2, 0, Br, Bi, 1, Cr, Ci, 1, 1, 1, 2,
                 nil, nil, 0, 0)

    int bad = 0
    if Cr[0] != 3.0 { bad = bad + 1; @print(f"FAIL re={Cr[0]} want 3") }
    if Ci[0] != 7.0 { bad = bad + 1; @print(f"FAIL im={Ci[0]} want 7") }

    // accumulate: start from C = 10+20i  ->  13+27i
    Cr[0] = 10.0 as f32; Ci[0] = 20.0 as f32
    cg.cgemm_ref(Ar, Ai, 2, 0, Br, Bi, 1, Cr, Ci, 1, 1, 1, 2,
                 nil, nil, 0, 1)
    if Cr[0] != 13.0 { bad = bad + 1; @print(f"FAIL acc re={Cr[0]} want 13") }
    if Ci[0] != 27.0 { bad = bad + 1; @print(f"FAIL acc im={Ci[0]} want 27") }

    c.free(Ar as *u8); c.free(Ai as *u8); c.free(Br as *u8)
    c.free(Bi as *u8); c.free(Cr as *u8); c.free(Ci as *u8)

    // same_bits self-test: it must be a real bit comparison, not a
    // value comparison. +0.0 and -0.0 compare == as f32 values but have
    // different bit patterns, so same_bits must report them as different.
    *f32 pz = c.malloc(4) as *f32
    *f32 nz = c.malloc(4) as *f32
    pz[0] = 0.0 as f32
    nz[0] = -(0.0 as f32)
    if tu.same_bits(pz, nz, 1) { bad = bad + 1; @print("FAIL same_bits(+0.0,-0.0) should be false") }

    *f32 sa = c.malloc(4) as *f32
    *f32 sb = c.malloc(4) as *f32
    sa[0] = 3.5 as f32
    sb[0] = 3.5 as f32
    if !tu.same_bits(sa, sb, 1) { bad = bad + 1; @print("FAIL same_bits(3.5,3.5) should be true") }

    c.free(pz as *u8); c.free(nz as *u8); c.free(sa as *u8); c.free(sb as *u8)

    if bad == 0 { @print("ALL PASS") }
}
