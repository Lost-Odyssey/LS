def main() {
    Big300 a = V0("hello")
    Big300 b = V150(150)
    Big300 c = V254(254)
    Big300 d = V255(255)
    Big300 e = V299(299)

    match a { V0(s) => { @print(s) } _ => { @print("wrong") } }
    match b { V150(n) => { @print(n) } _ => { @print(-1) } }
    match c { V254(n) => { @print(n) } _ => { @print(-1) } }
    match d { V255(n) => { @print(n) } _ => { @print(-1) } }
    match e { V299(n) => { @print(n) } _ => { @print(-1) } }

    @print("ALL PASS")
}
