// Phase A: shape validation for generic trait impls. Before this, the generic
// fold branch of check_impl_trait_decl returned early and NONE of these five
// mistakes was reported -- "Type check passed." rc=0.
interface Conv {
    def to_int(&self) -> int
}

interface Two {
    def a(&self) -> int
    def b(&self) -> int
}

interface Peek {
    def touch(&self) -> int
}

interface Maker {
    static def make() -> int
}

// (1) parameter count mismatch: interface declares 0 user params, impl takes 1
struct W1(T) { T v }
methods W1(T) { def id(&self) -> T { return self.v } }
methods W1(T): Conv {
    def to_int(&self, int extra) -> int { return extra }
}

// (2) missing method 'b'
struct W2(T) { T v }
methods W2(T) { def id(&self) -> T { return self.v } }
methods W2(T): Two {
    def a(&self) -> int { return 1 }
}

// (3) self parameter mismatch: interface requires &self, impl writes &!self
struct W3(T) { int n }
methods W3(T) { def id(&self) -> int { return self.n } }
methods W3(T): Peek {
    def touch(&!self) -> int { self.n = 9  return self.n }
}

// (4) static mismatch: interface declares it static, impl writes an instance method
struct W4(T) { int n }
methods W4(T) { def id(&self) -> int { return self.n } }
methods W4(T): Maker {
    def make(&self) -> int { return 1 }
}

// (5) method not declared in the interface
struct W5(T) { int n }
methods W5(T) { def id(&self) -> int { return self.n } }
methods W5(T): Conv {
    def to_int(&self) -> int { return self.n }
    def bogus(&self) -> int { return 2 }
}

def main() {
    @print(1)
}
