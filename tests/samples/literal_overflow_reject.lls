/* Out-of-range numeric literals must be rejected at parse time — previously
   strtoull/strtod saturated silently (ULLONG_MAX / HUGE_VAL) and over-long
   tokens were truncated to 63 chars, all miscompiling the constant. */
def main() -> int {
    int a = 99999999999999999999999
    int b = 0x1FFFFFFFFFFFFFFFF
    f64 c = 1e999
    int d = 999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999
    return 0
}
