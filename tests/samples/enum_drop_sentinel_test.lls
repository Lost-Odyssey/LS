// enum_drop_sentinel_test — pins the dead-tag sentinel contract
// (docs/plan_enum_drop_sentinel.md). Five shapes:
//  1. legal re-drop path (B-MAP-OPT-001 shape: owned rvalue subject,
//     arm with a loop) must stay silent under memcheck;
//  2. self-recursive enum construct/drop with value check;
//  3. nested has_drop enum payload drop;
//  4. repeated construct+destroy of a NAMED local in a loop — guards
//     decl zero-init + the ctor protocol across iterations. NOTE: `x`
//     here is a named local, destroyed via emit_enum_drop_cond, which
//     calls the drop-fn directly and never writes the sentinel — this
//     shape does NOT exercise slot reuse of a sentinel-carrying slot;
//  5. repeated match over an OWNED RVALUE subject in a loop — this is
//     the shape that actually reuses a sentinel-carrying slot every
//     iteration (emit_enum_drop writes tag=variant_count into
//     %match.subj, then the next iteration's match reinitializes the
//     same alloca and dispatches on it again).
// Every shape prints a value check; harness greps "SENTINEL PASS".

enum Inner { INil IStr(Str) }
enum Outer { ONil OWrap(Inner) }
enum Tree  { Leaf(int) Node(int, Tree, Tree) }

def heaped(Str base) -> Str {
    Str r = base
    r.push_str("_h")
    return r
}

def mk_vec(int n) -> Option(Vec(Str)) {
    if n > 0 {
        Str a = "a_h"
        Str b = "bb_h"
        Str c = "ccc_h"
        Vec(Str) v = [a, b, c]
        return Some(v)
    }
    return None
}

// shape 1: legal double-drop path (arm-internal flush + merge drop)
def shape1() -> int {
    int acc = 0
    match mk_vec(3) {
        Some(v) => {
            for x in &v { acc = acc + x.len() }
        }
        None => {}
    }
    return acc
}

// shape 2: recursive tree, sum-check
def sum(&Tree t) -> int {
    match t {
        Leaf(v) => v
        Node(v, l, r) => v + sum(l) + sum(r)
    }
}
def shape2() -> int {
    Tree t = Node(1, Node(2, Leaf(3), Leaf(4)), Leaf(5))
    return sum(&t)
}

// shape 3: nested has_drop enum payload
def shape3() -> int {
    Outer o = OWrap(IStr(heaped("abc")))
    match o {
        OWrap(i) => {
            match i {
                IStr(s) => { return s.len() }
                INil => { return 0 }
            }
        }
        ONil => { return -1 }
    }
    return -1
}

// shape 4: named-local construct+destroy repeated in a loop (decl
// zero-init + ctor protocol guard — NOT sentinel slot reuse, see header).
def shape4() -> int {
    int acc = 0
    for i in 0..100 {
        Inner x = IStr(heaped("xy"))
        match x {
            IStr(s) => { acc = acc + s.len() }
            INil => {}
        }
    }
    return acc
}

def mk_inner(int i) -> Inner {
    return IStr(heaped("xy"))
}

// shape 5: owned-rvalue subject repeated in a loop — the slot that
// carries the sentinel (match.subj) is genuinely reused every
// iteration: emit_enum_drop writes tag=variant_count into it at the
// end of one iteration, and the next iteration's match reinitializes
// the same alloca and dispatches on it again.
def shape5() -> int {
    int acc = 0
    for i in 0..100 {
        match mk_inner(i) {
            IStr(s) => { acc = acc + s.len() }
            INil => {}
        }
    }
    return acc
}

def main() {
    int ok = 1
    if shape1() != 12 { ok = 0 @print("FAIL: shape1") }
    if shape2() != 15 { ok = 0 @print("FAIL: shape2") }
    if shape3() != 5 { ok = 0 @print("FAIL: shape3") }
    if shape4() != 400 { ok = 0 @print("FAIL: shape4") }
    if shape5() != 400 { ok = 0 @print("FAIL: shape5") }
    if ok == 1 { @print("SENTINEL PASS") }
}
